# Snowflake service user the app signs in as (see ../snowflake/01_setup.sql and ../scripts/setup-keypair.sh)
SNOWFLAKE_ACCOUNT=SFSEHOL-ANTHROPIC_SNOWFLAKE_HACKATHON_JMZWKV
SNOWFLAKE_USER=HEALTHLINE_APP
SNOWFLAKE_ROLE=HEALTHLINE_APP_ROLE
SNOWFLAKE_WAREHOUSE=HEALTHLINE_WH
SNOWFLAKE_AGENT=HEALTHLINE.GOLD.ER_ASSISTANT

# Path to the private key from setup-keypair.sh (or set SNOWFLAKE_PRIVATE_KEY to the PEM itself)
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/you/.snowflake/keys/healthline_app.p8
